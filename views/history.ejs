<%- include("includes/head.ejs"); %>
<body>
    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="nav-inner">
            <a href="/home/<%=uname%>" class="brand-logo">
                <div class="brand-icon-box">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 18v-7a2 2 0 0 1 2-2h4v9"/>
                        <path d="M3 13h18"/>
                        <path d="M9 9V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v10"/>
                        <path d="M16 6v4M14 8h4"/>
                    </svg>
                </div>
                <span>HOSPITAL <span class="accent">SPACE</span></span>
            </a>

            <nav>
                <ul class="nav-menu" id="nav-menu">
                    <li><a href="/home/<%=uname%>" class="nav-link">Home</a></li>
                    <li><a href="/home/patient/<%=uname%>" class="nav-link">Manage Patients</a></li>
                    <li><a href="/history/<%=uname%>" class="nav-link active">Track Patients</a></li>
                </ul>
            </nav>

            <div class="nav-actions">
                <div class="user-badge">
                    <span class="user-avatar-dot"></span>
                    <span><%= uname %></span>
                </div>

                <button id="theme-btn" class="theme-toggle-btn" aria-label="Toggle theme">
                    <span id="theme-icon">🌙</span>
                </button>

                <a href="/" class="btn btn-secondary btn-sm">Sign Out</a>

                <button id="hamburger-btn" class="hamburger-btn" aria-label="Open Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <div class="page-wrapper">
        <main class="app-container">
            <div class="section-header section-header-flex">
                <div>
                    <div class="section-subtitle">Live Max-Heap Queue</div>
                    <h1 class="section-title">Priority Queue Triage</h1>
                </div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/home/patient/<%=uname%>" class="btn btn-primary">
                        <span>Admit Patient</span>
                    </a>
                    <a href="/home/<%=uname%>" class="btn btn-secondary">
                        <span>Dashboard</span>
                    </a>
                </div>
            </div>

            <!-- Real Database Summary Metric Chips & Bed Occupancy -->
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-icon-circle stat-icon-blue">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-val"><%= patient.length %></div>
                        <div class="stat-name">Total Patients</div>
                    </div>
                </div>

                <div class="stat-item">
                    <div class="stat-icon-circle stat-icon-green">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 18v-7a2 2 0 0 1 2-2h4v9" />
                            <path d="M3 13h18" />
                            <path d="M9 9V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v10" />
                            <path d="M16 6v4M14 8h4" />
                        </svg>
                    </div>
                    <div>
                        <div class="stat-val">
                            <%= typeof bedSummary !== 'undefined' && bedSummary.totals ? (bedSummary.totals.total_available || 0) : 0 %> / <%= typeof bedSummary !== 'undefined' && bedSummary.totals ? (bedSummary.totals.total_beds || 0) : 0 %>
                        </div>
                        <div class="stat-name">Beds Available</div>
                    </div>
                </div>

                <div class="stat-item">
                    <div class="stat-icon-circle stat-icon-orange">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-val"><%= patient.filter(p => p.allocation_status === 'WAITING').length %></div>
                        <div class="stat-name">Waiting For Bed</div>
                    </div>
                </div>

                <div class="stat-item">
                    <div class="stat-icon-circle stat-icon-red">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-val"><%= patient.filter(p => p.score >= 50).length %></div>
                        <div class="stat-name">Critical (&ge;50 pts)</div>
                    </div>
                </div>
            </div>

            <!-- Priority Queue Table Card -->
            <div class="table-card">
                <div class="table-toolbar">
                    <div class="search-wrap">
                        <input type="text" id="queue-search" class="search-input" placeholder="Search by name, ID, condition, or bed...">
                    </div>
                    <div style="font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono);">
                        Queue Sorting: <strong>Max-Heap Descending + FCFS</strong>
                    </div>
                </div>

                <% if (patient.length === 0) { %>
                    <div class="empty-state">
                        <div style="font-size: 2.5rem;">📋</div>
                        <h3>Queue is Currently Empty</h3>
                        <p style="max-width: 380px; font-size: 0.9rem;">No patients waiting in queue. Admit patients using the management portal to begin triage sorting and bed allocation.</p>
                        <a href="/home/patient/<%=uname%>" class="btn btn-primary" style="margin-top: 6px;">Admit Patient</a>
                    </div>
                <% } else { %>
                    <div class="table-scroll">
                        <table class="app-table" id="priority-queue-table">
                            <thead>
                                <tr>
                                    <th>Rank</th>
                                    <th>ID</th>
                                    <th>Patient Name</th>
                                    <th>Age</th>
                                    <th>Disease</th>
                                    <th>Wait</th>
                                    <th>Score</th>
                                    <th>Urgency</th>
                                    <th>Ward &amp; Bed Allocation</th>
                                    <th style="text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% let rank = 1; %>
                                <% for(let p of patient){ %>
                                    <% 
                                        let badgeClass = "badge-standard";
                                        let badgeLabel = "Standard";
                                        if (p.score >= 50) {
                                            badgeClass = "badge-critical";
                                            badgeLabel = "Critical";
                                        } else if (p.score >= 35) {
                                            badgeClass = "badge-high";
                                            badgeLabel = "High";
                                        } else if (p.score >= 25) {
                                            badgeClass = "badge-moderate";
                                            badgeLabel = "Moderate";
                                        }
                                    %>
                                    <tr>
                                        <td>
                                            <span class="rank-badge <%= rank === 1 ? 'rank-top' : '' %>">
                                                <%= rank %>
                                            </span>
                                        </td>
                                        <td><strong style="font-family: var(--font-mono);">#<%= p.id %></strong></td>
                                        <td><strong><%= p.name %></strong></td>
                                        <td><%= p.age %> yrs</td>
                                        <td><%= p.dis %></td>
                                        <td><%= p.wait != null ? p.wait : 0 %>h</td>
                                        <td>
                                            <span class="score-pill"><%= p.score %></span>
                                        </td>
                                        <td>
                                            <span class="priority-badge <%= badgeClass %>"><%= badgeLabel %></span>
                                        </td>
                                        <td>
                                            <% if (p.allocation_status === 'ALLOCATED') { %>
                                                <span class="priority-badge badge-standard">
                                                    🛏️ <%= p.ward_code || 'WARD' %> &bull; <%= p.bed_number %>
                                                </span>
                                            <% } else if (p.allocation_status === 'WAITING') { %>
                                                <span class="priority-badge badge-high">
                                                    ⏳ Queue (<%= p.ward_code || 'Bed' %>)
                                                </span>
                                            <% } else if (p.allocation_status === 'NEEDS_REVIEW') { %>
                                                <div>
                                                    <span class="priority-badge badge-critical" title="Condition requires clinical review">
                                                        ⚠️ Needs Review
                                                    </span>
                                                    <form method="post" action="/allocation/assign-ward/<%=uname%>" style="display: block; margin-top: 4px;">
                                                        <input type="hidden" name="patientId" value="<%= p.id %>">
                                                        <select name="wardCode" class="form-control" style="padding: 2px 6px; font-size: 0.75rem; height: 26px; width: 110px;" onchange="this.form.submit()">
                                                            <option value="">Assign Ward...</option>
                                                            <option value="ICU">ICU</option>
                                                            <option value="EMG">Emergency</option>
                                                            <option value="PED">Pediatric</option>
                                                            <option value="INF">Infectious</option>
                                                            <option value="GEN">General</option>
                                                        </select>
                                                    </form>
                                                </div>
                                            <% } else if (p.allocation_status === 'DISCHARGED') { %>
                                                <span class="priority-badge badge-moderate">
                                                    ✅ Discharged
                                                </span>
                                            <% } else { %>
                                                <span class="priority-badge badge-standard">Registered</span>
                                            <% } %>
                                        </td>
                                        <td style="text-align: right;">
                                            <form method="get" action="/history/<%= p.id %>/<%=uname%>" style="display: inline-block;">
                                                <button type="submit" class="btn btn-secondary btn-sm">
                                                    <span>View Details</span>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% rank++; %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="app-container footer-inner">
            <div><strong>HOSPITAL SPACE</strong> &mdash; Priority Queue System</div>
            <div>Computer Engineering Mini Project</div>
        </div>
    </footer>

    <script src="/hist.js"></script>
    <script>
        const btn = document.getElementById('theme-btn');
        const icon = document.getElementById('theme-icon');
        function sync() {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            if (icon) icon.textContent = isDark ? '☀️' : '🌙';
        }
        sync();
        if (btn) {
            btn.addEventListener('click', () => {
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                if (isDark) {
                    document.documentElement.removeAttribute('data-theme');
                    localStorage.setItem('hospital_theme', 'light');
                } else {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    localStorage.setItem('hospital_theme', 'dark');
                }
                sync();
            });
        }
        const hamburgerBtn = document.getElementById('hamburger-btn');
        const navMenu = document.getElementById('nav-menu');
        if (hamburgerBtn && navMenu) {
            hamburgerBtn.addEventListener('click', () => {
                const isOpen = navMenu.classList.toggle('open');
                hamburgerBtn.classList.toggle('open', isOpen);
            });
        }
    </script>
</body>
</html>