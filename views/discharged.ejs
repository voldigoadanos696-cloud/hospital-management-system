<%- include("includes/head.ejs"); %>
<body>
    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="nav-inner">
            <a href="/home/<%=uname%>" class="brand-logo">
                <div class="brand-icon-box">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 18v-7a2 2 0 0 1 2-2h4v9"/>
                        <path d="M3 13h18"/>
                        <path d="M9 9V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v10"/>
                        <path d="M16 6v4M14 8h4"/>
                    </svg>
                </div>
                <span>HOSPITAL <span class="accent">SPACE</span></span>
            </a>

            <nav>
                <ul class="nav-menu" id="nav-menu">
                    <li><a href="/home/<%=uname%>" class="nav-link">Home</a></li>
                    <li><a href="/home/patient/<%=uname%>" class="nav-link">Manage Patients</a></li>
                    <li><a href="/history/<%=uname%>" class="nav-link">Track Patients</a></li>
                    <li><a href="/discharged/<%=uname%>" class="nav-link active">Discharged Patients</a></li>
                </ul>
            </nav>

            <div class="nav-actions">
                <div class="user-badge">
                    <span class="user-avatar-dot"></span>
                    <span><%= uname %></span>
                </div>

                <button id="theme-btn" class="theme-toggle-btn" aria-label="Toggle theme">
                    <span id="theme-icon">🌙</span>
                </button>

                <a href="/" class="btn btn-secondary btn-sm">Sign Out</a>

                <button id="hamburger-btn" class="hamburger-btn" aria-label="Open Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <div class="page-wrapper">
        <main class="app-container">
            <div class="section-header section-header-flex">
                <div>
                    <div class="section-subtitle">Clinical Records &amp; Inpatient Audit</div>
                    <h1 class="section-title">Discharged Patients History</h1>
                </div>
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="/history/<%=uname%>" class="btn btn-secondary">
                        <span>Live Priority Queue</span>
                    </a>
                    <a href="/home/<%=uname%>" class="btn btn-primary">
                        <span>Ward Dashboard</span>
                    </a>
                </div>
            </div>

            <!-- Summary Chips & Retention Settings Card -->
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-icon-circle stat-icon-green">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-val"><%= dischargedPatients.length %></div>
                        <div class="stat-name">Total Discharged</div>
                    </div>
                </div>

                <div class="stat-item">
                    <div class="stat-icon-circle stat-icon-blue">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg>
                    </div>
                    <div>
                        <% 
                            let totalStay = 0;
                            for (let dp of dischargedPatients) {
                                totalStay += Number(dp.length_of_stay_hours || 0);
                            }
                            let avgStay = dischargedPatients.length > 0 ? (totalStay / dischargedPatients.length).toFixed(1) : 0;
                        %>
                        <div class="stat-val"><%= avgStay %> hrs</div>
                        <div class="stat-name">Avg Stay Duration</div>
                    </div>
                </div>

                <div class="stat-item">
                    <div class="stat-icon-circle stat-icon-orange">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                            <polyline points="17 21 17 13 7 13 7 21"></polyline>
                            <polyline points="7 3 7 8 15 8"></polyline>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-val"><%= typeof retentionSettings !== 'undefined' ? retentionSettings.dischargeRetentionDays : 90 %> days</div>
                        <div class="stat-name">Retention Window</div>
                    </div>
                </div>

                <div class="stat-item">
                    <div class="stat-icon-circle stat-icon-red">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="stat-val"><%= typeof expiredCount !== 'undefined' ? expiredCount : 0 %></div>
                        <div class="stat-name">Eligible for Cleanup</div>
                    </div>
                </div>
            </div>

            <!-- Retention Policy Configuration & Safe Cleanup Bar -->
            <div class="card-box" style="margin-bottom: 24px; padding: 20px 24px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                    <div>
                        <h3 style="margin-bottom: 4px; font-size: 1.05rem;">Data Retention &amp; Automatic Storage Policy</h3>
                        <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0;">
                            Configure how long completed discharge records remain archived before being safely purged. Active inpatients and waiting queue records are never deleted.
                        </p>
                    </div>
                    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
                        <button type="button" class="btn btn-secondary btn-sm" onclick="previewCleanup()">
                            Preview Expired Records
                        </button>
                        <button type="button" class="btn btn-danger btn-sm" onclick="openCleanupModal()">
                            Run Cleanup Now
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" onclick="openSettingsModal()">
                            Configure Policy
                        </button>
                    </div>
                </div>
                <div style="margin-top: 10px; font-size: 0.8rem; color: var(--text-secondary); display: flex; gap: 16px; flex-wrap: wrap;">
                    <span>Automatic Daily Cleanup: <strong><%= (typeof retentionSettings !== 'undefined' && retentionSettings.autoCleanupEnabled) ? '✅ Enabled' : '⏸️ Disabled (Manual Only)' %></strong></span>
                    <span>Account Scope: <strong><%= uname %></strong></span>
                </div>
            </div>

            <!-- Modal: Configure Retention Policy -->
            <div class="modal-overlay" id="settings-modal">
                <div class="modal-box">
                    <div class="modal-header">
                        <h3 style="margin: 0;">Configure Retention Policy</h3>
                        <button type="button" class="modal-close-btn" onclick="closeSettingsModal()">&times;</button>
                    </div>
                    <form method="POST" action="/discharged/retention-settings/<%= uname %>">
                        <div class="form-group" style="margin-bottom: 16px;">
                            <label class="form-label" for="retention-days">Retention Period (Days) <span class="required-indicator">*</span></label>
                            <select id="retention-days" name="days" class="form-control" required>
                                <option value="30" <%= (typeof retentionSettings !== 'undefined' && retentionSettings.dischargeRetentionDays === 30) ? 'selected' : '' %>>30 Days (1 Month)</option>
                                <option value="60" <%= (typeof retentionSettings !== 'undefined' && retentionSettings.dischargeRetentionDays === 60) ? 'selected' : '' %>>60 Days (2 Months)</option>
                                <option value="90" <%= (typeof retentionSettings !== 'undefined' && retentionSettings.dischargeRetentionDays === 90) ? 'selected' : '' %>>90 Days (Default - 3 Months)</option>
                                <option value="180" <%= (typeof retentionSettings !== 'undefined' && retentionSettings.dischargeRetentionDays === 180) ? 'selected' : '' %>>180 Days (6 Months)</option>
                                <option value="365" <%= (typeof retentionSettings !== 'undefined' && retentionSettings.dischargeRetentionDays === 365) ? 'selected' : '' %>>365 Days (1 Year)</option>
                            </select>
                        </div>

                        <div class="form-group" style="margin-bottom: 20px;">
                            <label style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem; cursor: pointer;">
                                <input type="checkbox" name="autoCleanupEnabled" value="true" <%= (typeof retentionSettings !== 'undefined' && retentionSettings.autoCleanupEnabled) ? 'checked' : '' %>>
                                <span>Enable Daily Automatic Background Cleanup</span>
                            </label>
                            <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-top: 4px;">
                                When enabled, our daily scheduler checks for records exceeding your configured retention window.
                            </span>
                        </div>

                        <div style="display: flex; gap: 10px; justify-content: flex-end;">
                            <button type="button" class="btn btn-secondary" onclick="closeSettingsModal()">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Retention Policy</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Modal: Dry Run Preview Results -->
            <div class="modal-overlay" id="preview-modal">
                <div class="modal-box" style="max-width: 600px;">
                    <div class="modal-header">
                        <h3 style="margin: 0;">Expired Discharged Records Preview</h3>
                        <button type="button" class="modal-close-btn" onclick="closePreviewModal()">&times;</button>
                    </div>
                    <div id="preview-content" style="max-height: 320px; overflow-y: auto; margin-bottom: 16px;">
                        <p>Loading preview...</p>
                    </div>
                    <div style="display: flex; justify-content: flex-end;">
                        <button type="button" class="btn btn-secondary" onclick="closePreviewModal()">Close Preview</button>
                    </div>
                </div>
            </div>

            <!-- Modal: Confirm Manual Cleanup -->
            <div class="modal-overlay" id="cleanup-modal">
                <div class="modal-box">
                    <div class="modal-header">
                        <h3 style="margin: 0; color: var(--urgency-critical);">Confirm Storage Cleanup</h3>
                        <button type="button" class="modal-close-btn" onclick="closeCleanupModal()">&times;</button>
                    </div>
                    <form method="POST" action="/discharged/cleanup/<%= uname %>">
                        <p style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 16px;">
                            This operation will permanently purge all discharged patient records and associated transfer logs older than <strong><%= typeof retentionSettings !== 'undefined' ? retentionSettings.dischargeRetentionDays : 90 %> days</strong>.
                        </p>
                        <div style="background: var(--urgency-critical-bg); color: var(--urgency-critical); padding: 12px; border-radius: var(--radius-sm); font-size: 0.85rem; margin-bottom: 16px;">
                            ⚠️ Type <strong>CONFIRM</strong> below to execute this transactional cleanup.
                        </div>
                        <div class="form-group" style="margin-bottom: 20px;">
                            <input type="text" name="confirmCleanup" class="form-control" placeholder="Type CONFIRM" required autocomplete="off">
                        </div>
                        <div style="display: flex; gap: 10px; justify-content: flex-end;">
                            <button type="button" class="btn btn-secondary" onclick="closeCleanupModal()">Cancel</button>
                            <button type="submit" class="btn btn-danger">Execute Storage Cleanup</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Discharged Patients Table Card -->
            <div class="table-card">
                <div class="table-toolbar">
                    <div class="search-wrap">
                        <input type="text" id="discharge-search" class="search-input" placeholder="Search by patient name, ID, ward, or bed...">
                    </div>
                    <div style="font-size: 0.82rem; color: var(--text-muted); font-family: var(--font-mono);">
                        Historical Records Preserved: <strong>Permanent</strong>
                    </div>
                </div>

                <% if (dischargedPatients.length === 0) { %>
                    <div class="empty-state">
                        <div style="font-size: 2.5rem;">📋</div>
                        <h3>No Discharged Patients Yet</h3>
                        <p style="font-size: 0.9rem;">Patients who complete inpatient treatment and are discharged will be archived here with their previous ward, bed, and dates.</p>
                        <a href="/home/patient/<%=uname%>" class="btn btn-primary" style="margin-top: 8px;">Go to Patient Management</a>
                    </div>
                <% } else { %>
                    <div class="table-scroll">
                        <table class="app-table" id="discharged-table">
                            <thead>
                                <tr>
                                    <th>Patient ID</th>
                                    <th>Patient Name</th>
                                    <th>Age</th>
                                    <th>Condition</th>
                                    <th>Previous Ward</th>
                                    <th>Previous Bed</th>
                                    <th>Admission Date</th>
                                    <th>Discharge Date</th>
                                    <th>Length of Stay</th>
                                    <th style="text-align: right;">Clinical Dossier</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (let p of dischargedPatients) { %>
                                    <tr>
                                        <td><strong style="font-family: var(--font-mono);">#<%= p.patient_id %></strong></td>
                                        <td><strong><%= p.patient_name %></strong></td>
                                        <td><%= p.patient_age %> yrs</td>
                                        <td><%= p.patient_condition %></td>
                                        <td>
                                            <span class="priority-badge badge-standard">
                                                <%= p.previous_ward_name ? (p.previous_ward_name + ' (' + p.previous_ward_code + ')') : 'Unassigned' %>
                                            </span>
                                        </td>
                                        <td>
                                            <strong style="font-family: var(--font-mono); color: var(--primary-navy);">
                                                <%= p.previous_bed_number ? ('🛏️ ' + p.previous_bed_number) : '--' %>
                                            </strong>
                                        </td>
                                        <td style="font-size: 0.82rem; color: var(--text-muted);">
                                            <%= p.admission_date ? new Date(p.admission_date).toLocaleString() : 'N/A' %>
                                        </td>
                                        <td style="font-size: 0.82rem; color: var(--urgency-standard); font-weight: 600;">
                                            <%= p.discharged_at ? new Date(p.discharged_at).toLocaleString() : 'N/A' %>
                                        </td>
                                        <td>
                                            <span class="score-pill" style="font-size: 0.8rem;">
                                                <%= p.length_of_stay_hours != null ? p.length_of_stay_hours + 'h' : '--' %>
                                            </span>
                                        </td>
                                        <td style="text-align: right;">
                                            <a href="/history/<%= p.patient_id %>/<%= uname %>" class="btn btn-secondary btn-sm">
                                                View Dossier
                                            </a>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>
        </main>
    </div>

    <!-- Footer -->
    <footer class="app-footer">
        <div class="app-container footer-inner">
            <div><strong>HOSPITAL SPACE</strong> &mdash; Priority Queue System</div>
            <div>Computer Engineering Mini Project</div>
        </div>
    </footer>

    <script>
        function openSettingsModal() {
            const m = document.getElementById('settings-modal');
            if (m) m.classList.add('open');
        }
        function closeSettingsModal() {
            const m = document.getElementById('settings-modal');
            if (m) m.classList.remove('open');
        }

        function openCleanupModal() {
            const m = document.getElementById('cleanup-modal');
            if (m) m.classList.add('open');
        }
        function closeCleanupModal() {
            const m = document.getElementById('cleanup-modal');
            if (m) m.classList.remove('open');
        }

        async function previewCleanup() {
            const m = document.getElementById('preview-modal');
            const content = document.getElementById('preview-content');
            if (m && content) {
                m.classList.add('open');
                content.innerHTML = '<p style="padding: 10px; color: var(--text-muted);">Fetching expired records preview from database...</p>';
                try {
                    const res = await fetch('/discharged/preview-cleanup/<%= uname %>');
                    const data = await res.json();
                    if (data.success) {
                        if (data.count === 0) {
                            content.innerHTML = '<div style="padding: 16px; text-align: center; color: var(--urgency-standard); font-weight: 600;">✅ No records currently exceed the retention threshold. Storage is fully compliant.</div>';
                        } else {
                            let html = `<p style="font-size: 0.85rem; margin-bottom: 10px;">Found <strong>${data.count}</strong> records eligible for safe deletion:</p>`;
                            html += '<table class="app-table" style="font-size: 0.82rem;"><thead><tr><th>ID</th><th>Name</th><th>Condition</th><th>Latest Discharge</th><th>Elapsed Days</th></tr></thead><tbody>';
                            for (let p of data.expired) {
                                html += `<tr>
                                    <td>#${p.patient_id}</td>
                                    <td><strong>${p.patient_name}</strong></td>
                                    <td>${p.patient_condition}</td>
                                    <td>${new Date(p.latest_discharge_date).toLocaleDateString()}</td>
                                    <td><span class="score-pill">${p.days_since_discharge}d</span></td>
                                </tr>`;
                            }
                            html += '</tbody></table>';
                            content.innerHTML = html;
                        }
                    } else {
                        content.innerHTML = `<p style="color: var(--urgency-critical);">Error loading preview: ${data.error}</p>`;
                    }
                } catch (e) {
                    content.innerHTML = `<p style="color: var(--urgency-critical);">Network error fetching preview.</p>`;
                }
            }
        }
        function closePreviewModal() {
            const m = document.getElementById('preview-modal');
            if (m) m.classList.remove('open');
        }

        window.addEventListener('click', (e) => {
            const sm = document.getElementById('settings-modal');
            const cm = document.getElementById('cleanup-modal');
            const pm = document.getElementById('preview-modal');
            if (e.target === sm) closeSettingsModal();
            if (e.target === cm) closeCleanupModal();
            if (e.target === pm) closePreviewModal();
        });

        // Real-time table search filter
        const searchInput = document.getElementById('discharge-search');
        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const term = this.value.toLowerCase().trim();
                const rows = document.querySelectorAll('#discharged-table tbody tr');
                rows.forEach(r => {
                    r.style.display = r.textContent.toLowerCase().includes(term) ? '' : 'none';
                });
            });
        }

        const btn = document.getElementById('theme-btn');
        const icon = document.getElementById('theme-icon');
        function sync() {
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
            if (icon) icon.textContent = isDark ? '☀️' : '🌙';
        }
        sync();
        if (btn) {
            btn.addEventListener('click', () => {
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                if (isDark) {
                    document.documentElement.removeAttribute('data-theme');
                    localStorage.setItem('hospital_theme', 'light');
                } else {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    localStorage.setItem('hospital_theme', 'dark');
                }
                sync();
            });
        }
        const hamburgerBtn = document.getElementById('hamburger-btn');
        const navMenu = document.getElementById('nav-menu');
        if (hamburgerBtn && navMenu) {
            hamburgerBtn.addEventListener('click', () => {
                const isOpen = navMenu.classList.toggle('open');
                hamburgerBtn.classList.toggle('open', isOpen);
            });
        }
    </script>
</body>
</html>
